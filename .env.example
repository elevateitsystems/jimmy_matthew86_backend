NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:root@localhost:5432/container_tracker?schema=public"

JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=7d

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

SEED_ADMIN_NAME=Java Maryland Admin
SEED_ADMIN_EMAIL=admin@javamaryland.com
SEED_ADMIN_PASSWORD=change-this-password
SEED_STAFF_NAME=Java Maryland Staff
SEED_STAFF_EMAIL=staff@javamaryland.com
SEED_STAFF_PASSWORD=change-this-password

OPENTRACK_API_KEY=your-opentrack-api-key
OPENTRACK_API_URL=https://api.opentrack.co
APP_NAME=Java Maryland
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
ALERT_EMAIL_TO=
